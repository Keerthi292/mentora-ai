# Copy to backend/.env and fill in real values. Never commit backend/.env.

DATABASE_URL=postgresql+psycopg2://mentora:mentora_dev@localhost:5432/mentora
# Optional, defaults to 1
DEMO_USER_ID=1

# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash. The free tier allows only ~20 requests/day per
# model; another model (e.g. gemini-3.5-flash-lite) has its own separate daily limit.
GEMINI_MODEL=gemini-3.5-flash
# Optional, defaults to 60
GEMINI_TIMEOUT_SECONDS=60
# Optional: earlier chat messages sent with each new one (0 = none), defaults to 20
CHAT_HISTORY_LIMIT=20
# Optional: max size per uploaded file in MB (chat attachments, project images), defaults to 20
MAX_UPLOAD_MB=20
# Optional: where uploaded files are saved, defaults to backend/uploads (not in Git)
# UPLOAD_DIR=/path/to/uploads
