# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Private addresses and passwords live only here, never in the code.

# Required. Use the same password you gave PostgreSQL (POSTGRES_PASSWORD) in docker run
DATABASE_URL=postgresql+psycopg2://mentora:YOUR_DB_PASSWORD@localhost:5432/mentora

# Optional, these are the defaults: where `uv run main.py` runs the backend
API_HOST=127.0.0.1
API_PORT=8002
# Optional: other sites allowed to call the API from a browser (CORS), comma-separated.
# Not needed when the frontend forwards /api to the backend (the dev server and Render do).
CORS_ORIGINS=

# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash. The free tier allows only ~20 requests/day per
# model; another model (e.g. gemini-3.5-flash-lite) has its own separate daily limit.
GEMINI_MODEL=gemini-3.5-flash
# Optional, defaults to 60
GEMINI_TIMEOUT_SECONDS=60
# Optional: earlier chat messages sent with each new one (0 = none), defaults to 20
CHAT_HISTORY_LIMIT=20
# Optional: max size per uploaded file in MB (chat attachments, project images), defaults to 20
MAX_UPLOAD_MB=20
# Optional: where uploaded files are saved, defaults to backend/uploads (not in Git)
# UPLOAD_DIR=/path/to/uploads

# Logins: how many days a login lasts (default 30). Set COOKIE_SECURE=true when served over HTTPS.
# SESSION_DAYS=30
# COOKIE_SECURE=false

# MCP (/mcp): clients must send "Authorization: Bearer <MCP_TOKEN>"; the tools act as MCP_USER_ID.
# Make a token with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without MCP_TOKEN, /mcp refuses every request.
MCP_TOKEN=
MCP_USER_ID=1
